/** The calls Go makes of the host, on the UI thread. */
export interface HostCalls {
  /** the app's bundle and the system's settings, asked once at start */
  appInfo(): AppInfoReply
  /** the name of the system's time zone; any thread */
  timeZone(): TimeZoneReply
  /** the appearance and the accessibility preferences */
  theme(): ThemeReply
  /** the appearance the app asks for: "light", "dark" or "system" */
  setAppearance(c: SetAppearanceCall): void
  /** the screen's size in DIPs and scale */
  screen(): ScreenReply
  /** a line the app wrote to its standard output or error */
  log(c: LogCall): void
  /** the screen's content: a web view, or a surface for native UI */
  createWindow(c: CreateWindowCall): CreateWindowReply
  /** the window's content presented its first frame */
  firstFrame(c: FirstFrameCall): void
  /** where a surface shows the windows it holds (Parent), under it, in the order painted; the others hide. Places: encoded by Go (encodePlaces) */
  placeViews(c: PlaceViewsCall): void
  showWindow(c: ShowWindowCall): void
  hideWindow(c: HideWindowCall): void
  closeWindow(c: CloseWindowCall): void
  setBackground(c: SetBackgroundCall): void
  focus(c: FocusCall): void
  /** the window's title, which a navigation bar shows */
  setTitle(c: SetTitleCall): void
  /** a bar of tabs, whose tabs AddTab adds before ShowTabs shows it */
  createTabs(c: CreateTabsCall): void
  addTab(c: AddTabCall): void
  showTabs(c: ShowTabsCall): void
  selectTab(c: SelectTabCall): void
  setTabBadge(c: SetTabBadgeCall): void
  closeTabs(c: CloseTabsCall): void
  /** shows Child over Parent in Parent's stack, under a bar with its Title and a back button */
  pushWindow(c: PushWindowCall): void
  popWindow(c: PopWindowCall): void
  /** a router's pages as the window's stack of screens, its first page and those deeper (Titles, told apart by Keys): the screens of the keys the stack shows stay, the others are pushed, popped or replaced; none take the stack away. Answered once the screen going out of sight holds what the surface shows, as the surface is about to show the page coming */
  setStack(c: SetStackCall): SetStackReply
  /** the surface shows the page of the stack's last screen, after SetStack or StackPopped */
  stackShown(c: StackShownCall): void
  loadURL(c: LoadURLCall): void
  loadHTML(c: LoadHTMLCall): void
  reload(c: ReloadCall): void
  stopLoading(c: StopLoadingCall): void
  goBack(c: GoBackCall): void
  goForward(c: GoForwardCall): void
  eval(c: EvalCall): void
  /** runs Body as an async function's; AsyncResult answers */
  callAsync(c: CallAsyncCall): void
  setZoom(c: SetZoomCall): void
  setUserAgent(c: SetUserAgentCall): void
  setUserScripts(c: SetUserScriptsCall): void
  /** a PNG of the page; Captured answers */
  capturePage(c: CapturePageCall): void
  userAgent(c: UserAgentCall): UserAgentReply
  /** the status and headers of a SchemeRequest (Header: names and values in turn) */
  schemeRespond(c: SchemeRespondCall): void
  schemeData(c: SchemeDataCall): void
  schemeFinish(c: SchemeFinishCall): void
  schemeFail(c: SchemeFailCall): void
  /** an alert; MessageBoxResult answers */
  messageBox(c: MessageBoxCall): void
  /** the system's picker of documents; FilesResult answers with copies the app may read */
  openFiles(c: OpenFilesCall): void
  /** the share sheet of a file, as the place to save it */
  shareFile(c: ShareFileCall): void
  clipboardText(): ClipboardTextReply
  setClipboardText(c: SetClipboardTextCall): void
  /** opens a URL in the app the system has for it */
  openURL(c: OpenURLCall): OpenURLReply
  secretGet(c: SecretGetCall): SecretGetReply
  secretSet(c: SecretSetCall): SecretSetReply
  secretDelete(c: SecretDeleteCall): SecretDeleteReply
  /** a local notification; NotifyDone answers once the system has it */
  notify(c: NotifyCall): void
  removeNotification(c: RemoveNotificationCall): void
  removeAllNotifications(): void
  /** keeps the screen on while the app shows */
  keepAwake(c: KeepAwakeCall): void
  networkStatus(): NetworkStatusReply
  /** starts NetworkChanged */
  watchNetwork(): void
  battery(): BatteryReply
  /** the icons of the system's bars ("auto", "light" or "dark"), and whether the bars hide */
  setSystemBars(c: SetSystemBarsCall): void
  /** the orientations the screen may take: 1 portrait, 2 upside down, 4 landscape left, 8 landscape right; 0 any */
  setOrientations(c: SetOrientationsCall): void
  /** the share sheet of text, a link and files; ShareResult answers */
  share(c: ShareCall): void
  /** the system's picker of where to keep a copy of Path under Name; FilesResult answers with the place, empty when dismissed */
  saveFile(c: SaveFileCall): void
  clipboardImage(): ClipboardImageReply
  setClipboardImage(c: SetClipboardImageCall): void
  /** the system's menu at a point of the window: Items are encoded by Go (encodeMenu); MenuPicked answers with the item's ID, 0 when dismissed */
  popupMenu(c: PopupMenuCall): void
  /** the buttons at the end of the window's navigation bar; BarItemClicked tells which: titles, symbols and icons by index */
  setBarItems(c: SetBarItemsCall): void
  /** a call of a plugin's native code: Args and PluginResult's Result are JSON */
  pluginCall(c: PluginCallCall): void
  /** opens the sound's output: stereo at Rate frames a second, holding about Ahead milliseconds; on the caller's thread */
  audioOpen(c: AudioOpenCall): AudioOpenReply
  /** plays interleaved stereo float32 samples after those written, waiting while the output holds enough; on the caller's thread */
  audioWrite(c: AudioWriteCall): AudioWriteReply
  audioClose(): AudioCloseReply
  /** "selection", "light", "medium", "heavy", "success", "warning" or "error" */
  haptic(c: HapticCall): void
  /** asks for a Frame at the next refresh of the display */
  requestFrame(c: RequestFrameCall): void
  /** whether the keyboard shows and what for: the input's traits (platform.TextTraits), and its text. Show counts the requests to show the keyboard again. Offsets are UTF-16 units of the document, of which Text is the part around the selection, from Base; MarkStart is -1 without marked text. A window without Document takes text without one, as a terminal: the keyboard sees none */
  setTextInput(c: SetTextInputCall): void
  /** the pointer's shape, for a mouse or a trackpad */
  setCursor(c: SetCursorCall): void
  /** the tree of accessible elements changed; Focus names the one with the focus */
  accessibilityChanged(c: AccessibilityChangedCall): void
  announce(c: AnnounceCall): void
  /** the system's edit menu at a point, with the actions given (cut, copy, paste, selectAll); TextCommand answers */
  showMenu(c: ShowMenuCall): void
  /** takes the edit menu of ShowMenu away */
  hideMenu(c: HideMenuCall): void
  /** whether the content takes the system's back */
  setBackAvailable(c: SetBackAvailableCall): void
  /** the system's magnifier of what is at a point */
  showMagnifier(c: ShowMagnifierCall): void
  hideMagnifier(c: HideMagnifierCall): void
  /** the metrics of a font (Android's Paint): ascent and descent, x-height, underline and strikethrough */
  textMetrics(c: TextMetricsCall): TextMetricsReply
  /** how wide each of Texts is in a font, kerned unless NoKern */
  measureText(c: MeasureTextCall): MeasureTextReply
  /** the advance of each UTF-16 unit of Text laid out as a whole (getTextRunAdvances) */
  textAdvances(c: TextAdvancesCall): TextAdvancesReply
  /** how wide Text's UTF-16 units [Start, End) are laid out within the whole of Text, right to left if RTL, as a TextView measures a span (getRunAdvance) */
  measureTextRun(c: MeasureTextRunCall): MeasureTextRunReply
  /** draws Text in white at Scale pixels per DIP, its pen DX pixels right of a pixel's edge: its ink's box from the pen and its pixels, a byte of coverage each, or premultiplied RGBA when Color. When End > 0, only its UTF-16 units [Start, End), laid out within the whole, right to left if RTL (drawTextRun), from the pen at their left */
  drawText(c: DrawTextCall): DrawTextReply
  /** adds a font file under Family, or its own family when empty */
  registerFont(c: RegisterFontCall): RegisterFontReply
  /** how many Frames a second come from now on while they follow each other, a whole fraction of the display's rate, or 0 for the display's own (platform.FrameRateSurface) */
  setFrameRate(c: SetFrameRateCall): void
  /** a tab's title, which the bar shows */
  setTabTitle(c: SetTabTitleCall): void
}

/** Runs a call on h and encodes its reply, null for a call not waited for. */
export function dispatchCall(h: HostCalls, buf: Uint8Array): Uint8Array | null {
  const r = new WireReader(buf)
  const w = new WireWriter()
  switch (r.uvarint()) {
    case 1:
      h.appInfo().encode(w)
      return w.done()
    case 2:
      h.timeZone().encode(w)
      return w.done()
    case 3:
      h.theme().encode(w)
      return w.done()
    case 4:
      h.setAppearance(SetAppearanceCall.decode(r))
      return null
    case 5:
      h.screen().encode(w)
      return w.done()
    case 6:
      h.log(LogCall.decode(r))
      return null
    case 7:
      h.createWindow(CreateWindowCall.decode(r)).encode(w)
      return w.done()
    case 8:
      h.firstFrame(FirstFrameCall.decode(r))
      return null
    case 9:
      h.placeViews(PlaceViewsCall.decode(r))
      return null
    case 10:
      h.showWindow(ShowWindowCall.decode(r))
      return null
    case 11:
      h.hideWindow(HideWindowCall.decode(r))
      return null
    case 12:
      h.closeWindow(CloseWindowCall.decode(r))
      return null
    case 13:
      h.setBackground(SetBackgroundCall.decode(r))
      return null
    case 14:
      h.focus(FocusCall.decode(r))
      return null
    case 15:
      h.setTitle(SetTitleCall.decode(r))
      return null
    case 16:
      h.createTabs(CreateTabsCall.decode(r))
      return null
    case 17:
      h.addTab(AddTabCall.decode(r))
      return null
    case 18:
      h.showTabs(ShowTabsCall.decode(r))
      return null
    case 19:
      h.selectTab(SelectTabCall.decode(r))
      return null
    case 20:
      h.setTabBadge(SetTabBadgeCall.decode(r))
      return null
    case 21:
      h.closeTabs(CloseTabsCall.decode(r))
      return null
    case 22:
      h.pushWindow(PushWindowCall.decode(r))
      return null
    case 23:
      h.popWindow(PopWindowCall.decode(r))
      return null
    case 24:
